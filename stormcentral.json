{
  "type": "plugin",
  "name": "Weather Fronts",
  "author": "Zenitsu132",
  "description": "WPC forecast fronts, highs and lows for the next three days.",
  "version": "1.0.0",
  "layers": [
    {
      "type": "raster",
      "id": "fronts-day1",
      "name": "Fronts (Day 1)",
      "tiles": [
        "https://mapservices.weather.noaa.gov/vector/rest/services/outlooks/natl_fcst_wx_chart/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:2&f=image"
      ],
      "maxzoom": 12,
      "opacity": 0.9,
      "attribution": "Fronts: NOAA/NWS Prediction Center"
    },
    {
        "type": "raster",
      "id": "highs-lows-day1",
      "name": "Highs and lows (Day 1)",
